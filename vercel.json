{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,

  "// rewrites": "Each marketing route serves index.html so the client router can render it. They are listed explicitly rather than caught by a wildcard, so /planner/ and every static asset keep resolving normally.",
  "rewrites": [
    { "source": "/about",              "destination": "/index.html" },
    { "source": "/windows",            "destination": "/index.html" },
    { "source": "/doors",              "destination": "/index.html" },
    { "source": "/materials",          "destination": "/index.html" },
    { "source": "/guidance",           "destination": "/index.html" },
    { "source": "/guide-repair",       "destination": "/index.html" },
    { "source": "/guide-conservation", "destination": "/index.html" },
    { "source": "/accreditation",      "destination": "/index.html" },
    { "source": "/projects",           "destination": "/index.html" },
    { "source": "/heritage",           "destination": "/index.html" },
    { "source": "/contact",            "destination": "/index.html" }
  ],

  "redirects": [
    { "source": "/drawing-board", "destination": "/materials", "permanent": true },
    { "source": "/index.html",    "destination": "/",          "permanent": true }
  ],

  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Permissions-Policy", "value": "geolocation=(), microphone=(), camera=(), payment=(), interest-cohort=()" }
      ]
    },
    {
      "source": "/planner/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Cache-Control", "value": "no-store, max-age=0" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://esm.sh; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://esm.sh; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [{ "key": "Content-Type", "value": "application/xml; charset=utf-8" }]
    }
  ]
}
